<?xml version="1.0" encoding="UTF-8"?>
<!-- One smart playlist rule: field (15), operator (16), value (17), browse (20); 18 OK, 19 cancel. -->
<window>
	<defaultcontrol always="true">15</defaultcontrol>
	<controls>
		<include>DialogScrim</include>
		<control type="group">
			<left>460</left>
			<top>260</top>
			<include>DialogEase</include>
			<include content="DialogPanel">
				<param name="width" value="1000" />
				<param name="height" value="560" />
				<param name="heading_id" value="9002" />
			</include>
			<control type="label">
				<left>40</left>
				<top>32</top>
				<width>920</width>
				<height>44</height>
				<font>head</font>
				<textcolor>white</textcolor>
				<label>Rule</label>
			</control>
			<control type="grouplist" id="9000">
				<onup>noop</onup>
				<left>40</left>
				<top>100</top>
				<width>920</width>
				<height>300</height>
				<orientation>vertical</orientation>
				<itemgap>2</itemgap>
				<ondown>9001</ondown>
				<include content="FormButton"><param name="id" value="15" /><param name="label" value="Field" /><param name="width" value="920" /></include>
				<include content="FormButton"><param name="id" value="16" /><param name="label" value="Operator" /><param name="width" value="920" /></include>
				<include content="FormEdit"><param name="id" value="17" /><param name="label" value="Value" /><param name="width" value="920" /></include>
				<include content="FormButton"><param name="id" value="20" /><param name="label" value="Browse" /><param name="width" value="920" /></include>
			</control>
			<control type="grouplist" id="9001">
				<onleft>noop</onleft>
				<onright>noop</onright>
				<left>40</left>
				<top>460</top>
				<width>920</width>
				<height>60</height>
				<orientation>horizontal</orientation>
				<itemgap>14</itemgap>
				<onup>9000</onup>
				<control type="button" id="18">
					<include>ButtonStyle</include>
					<label>OK</label>
				</control>
				<control type="button" id="19">
					<include>ButtonStyle</include>
					<label>Cancel</label>
				</control>
			</control>
		</control>
	</controls>
</window>
