<?xml version="1.0" encoding="UTF-8"?>
<!-- Player "More" menu (OSD > list button): everything Kodi offers during
     playback that doesn't need its own button. Each entry closes the menu
     and opens Kodi's own dialog. -->
<window type="dialog" id="1153">
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>
		<include>DialogScrim</include>
		<control type="group">
			<left>1084</left>
			<top>180</top>
			<include>DialogEase</include>
			<include content="DialogPanel">
				<param name="width" value="740" />
				<param name="height" value="720" />
				<param name="heading_id" value="9001" />
			</include>
			<control type="label">
				<left>40</left>
				<top>32</top>
				<width>660</width>
				<height>44</height>
				<font>head</font>
				<textcolor>white</textcolor>
				<label>Playback</label>
			</control>
			<control type="list" id="9000">
				<onup>noop</onup>
				<ondown>noop</ondown>
				<left>24</left>
				<top>100</top>
				<width>692</width>
				<height>600</height>
				<orientation>vertical</orientation>
				<onback>Dialog.Close(1153)</onback>
				<itemlayout width="692" height="64"><include>SelectRow</include></itemlayout>
				<focusedlayout width="692" height="64">
					<include content="Box">
						<param name="width" value="692" />
						<param name="height" value="64" />
						<param name="color" value="wood" />
					</include>
					<include>SelectRowFocus</include>
				</focusedlayout>
				<content>
					<item>
						<label>Subtitles</label>
						<label2>$INFO[VideoPlayer.SubtitlesLanguage]</label2>
						<onclick>Dialog.Close(1153)</onclick>
						<onclick>ActivateWindow(osdsubtitlesettings)</onclick>
					</item>
					<item>
						<label>Download subtitles</label>
						<onclick>Dialog.Close(1153)</onclick>
						<onclick>ActivateWindow(subtitlesearch)</onclick>
					</item>
					<item>
						<label>Audio</label>
						<label2>$INFO[VideoPlayer.AudioLanguage]</label2>
						<onclick>Dialog.Close(1153)</onclick>
						<onclick>ActivateWindow(osdaudiosettings)</onclick>
					</item>
					<item>
						<label>Video</label>
						<label2>Zoom, aspect, deinterlace</label2>
						<onclick>Dialog.Close(1153)</onclick>
						<onclick>ActivateWindow(osdvideosettings)</onclick>
					</item>
					<item>
						<label>Bookmarks and chapters</label>
						<label2>$INFO[Player.ChapterCount,, chapters]</label2>
						<onclick>Dialog.Close(1153)</onclick>
						<onclick>ActivateWindow(videobookmarks)</onclick>
					</item>
					<item>
						<label>Playlist</label>
						<label2>$INFO[Playlist.Length(video),, items]</label2>
						<onclick>Dialog.Close(1153)</onclick>
						<onclick>Dialog.Close(videoosd)</onclick>
						<onclick>ActivateWindow(videoplaylist)</onclick>
					</item>
					<item>
						<label>Player info</label>
						<label2>Codec, resolution, buffer</label2>
						<onclick>Dialog.Close(1153)</onclick>
						<onclick>Dialog.Close(videoosd)</onclick>
						<onclick>Action(PlayerProcessInfo)</onclick>
					</item>
					<item>
						<label>Details</label>
						<onclick>Dialog.Close(1153)</onclick>
						<onclick>Dialog.Close(videoosd)</onclick>
						<onclick>Action(Info)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
