<?xml version="1.0" encoding="UTF-8"?>
<!--
	Kodi's add-on browser (repositories, categories, search, installed).
	500 icon grid when the folder lists add-ons, 50 list for categories.
	Selecting an add-on opens DialogAddonInfo.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>navy900</backgroundcolor>
	<views>500,50</views>
	<include>ScreenEase</include>
	<controls>
		<include content="Box">
			<param name="width" value="1920" />
			<param name="height" value="1080" />
		</include>

		<control type="label">
			<left>96</left>
			<top>124</top>
			<width>1000</width>
			<height>96</height>
			<aligny>center</aligny>
			<font>title</font>
			<textcolor>white</textcolor>
			<scroll>false</scroll>
			<label>$VAR[AddonBrowserTitle]</label>
		</control>
		<control type="label">
			<left>96</left>
			<top>218</top>
			<width>900</width>
			<height>30</height>
			<font>small</font>
			<textcolor>gray400</textcolor>
			<label>$INFO[Container.NumItems,, items]</label>
		</control>

		<!-- 500: add-ons -->
		<control type="panel" id="500">
			<onright>noop</onright>
			<ondown>noop</ondown>
			<left>89</left>
			<top>268</top>
			<width>1740</width>
			<height>812</height>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">350</scrolltime>
			<onleft>noop</onleft>
			<onup>9040</onup>
			<viewtype label="Icons">bigicon</viewtype>
			<itemlayout width="236" height="320">
				<include content="AddonTile"><param name="id" value="500" /></include>
			</itemlayout>
			<focusedlayout width="236" height="320">
				<include content="AddonTile"><param name="id" value="500" /><param name="focused" value="true" /></include>
			</focusedlayout>
		</control>

		<!-- 50: categories, repositories, anything else -->
		<control type="list" id="50">
			<ondown>noop</ondown>
			<left>96</left>
			<top>268</top>
			<width>1728</width>
			<height>812</height>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">300</scrolltime>
			<onleft>noop</onleft>
			<onup>9040</onup>
			<viewtype label="List">list</viewtype>
			<itemlayout width="1728" height="104">
				<include>ListRow</include>
			</itemlayout>
			<focusedlayout width="1728" height="104">
				<include content="Box">
					<param name="top" value="2" />
					<param name="width" value="1728" />
					<param name="height" value="100" />
					<param name="color" value="navy800" />
					<param name="visible" value="Control.HasFocus(50)" />
				</include>
				<include content="FocusRing">
					<param name="top" value="2" />
					<param name="width" value="1728" />
					<param name="height" value="100" />
					<param name="visible" value="Control.HasFocus(50)" />
				</include>
				<include>ListRow</include>
			</focusedlayout>
		</control>

		<include>NowPlayingMini</include>
		<include content="Rail">
			<param name="onright" value="SetFocus($VAR[AddonView])" />
		</include>
		<include content="OptionsPanel">
			<param name="return" value="$VAR[AddonView]" />
			<param name="extras" value="OptionsNone" />
		</include>
	</controls>
</window>
