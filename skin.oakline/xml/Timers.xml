<?xml version="1.0" encoding="UTF-8"?>
<!-- Skin timers (Kodi 20+): run actions when a condition becomes true.
     Movies and Music stay inside their collections: if the window steps above
     the root (the Back card at the top), it goes back to the root and on to Home,
     like the Back key there. -->
<timers>
	<timer>
		<name>oak_movies_guard</name>
		<description>Movies section left the videos folder</description>
		<start reset="true">Window.IsActive(videos) + String.IsEqual(Window(home).Property(oak_section),movies) + !String.IsEmpty(Skin.String(oak_videos)) + !Container.IsUpdating + [String.IsEmpty(Container.FolderPath) | String.IsEqual(Container.FolderPath,sources://video/) | [String.StartsWith(Skin.String(oak_videos),Container.FolderPath) + !String.IsEqual(Container.FolderPath,Skin.String(oak_videos))]]</start>
		<onstart>Container.Update($INFO[Skin.String(oak_videos)],replace)</onstart>
		<onstart>ActivateWindow(Home)</onstart>
		<stop>![Window.IsActive(videos) + String.IsEqual(Window(home).Property(oak_section),movies) + !String.IsEmpty(Skin.String(oak_videos)) + !Container.IsUpdating + [String.IsEmpty(Container.FolderPath) | String.IsEqual(Container.FolderPath,sources://video/) | [String.StartsWith(Skin.String(oak_videos),Container.FolderPath) + !String.IsEqual(Container.FolderPath,Skin.String(oak_videos))]]]</stop>
	</timer>
	<timer>
		<name>oak_music_guard</name>
		<description>Music section left the music library</description>
		<start reset="true">Window.IsActive(music) + String.IsEqual(Window(home).Property(oak_section),music) + !Container.IsUpdating + [String.IsEmpty(Container.FolderPath) | String.IsEqual(Container.FolderPath,musicdb://) | String.StartsWith(Container.FolderPath,sources://)]</start>
		<onstart>Container.Update(musicdb://albums/,replace)</onstart>
		<onstart>ActivateWindow(Home)</onstart>
		<stop>![Window.IsActive(music) + String.IsEqual(Window(home).Property(oak_section),music) + !Container.IsUpdating + [String.IsEmpty(Container.FolderPath) | String.IsEqual(Container.FolderPath,musicdb://) | String.StartsWith(Container.FolderPath,sources://)]]</stop>
	</timer>
	<!-- auto theme: a change that came due during a video or a dialog (scripts/theme.py) -->
	<timer>
		<name>oak_theme_pending</name>
		<description>Apply the day / night theme once nothing is playing</description>
		<start reset="true">String.IsEqual(Window(home).Property(oak_theme_pending),1) + !Player.HasVideo + !System.HasActiveModalDialog</start>
		<onstart>RunScript(special://skin/scripts/theme.py,tick)</onstart>
		<stop>![String.IsEqual(Window(home).Property(oak_theme_pending),1) + !Player.HasVideo + !System.HasActiveModalDialog]</stop>
	</timer>
	<!-- pausing a video brings up the controls (Play is focused: OK resumes); skipping keeps the bare timeline -->
	<timer>
		<name>oak_osd_on_pause</name>
		<description>Open the player controls when a video is paused</description>
		<start reset="true">Player.Paused + Player.HasVideo + Window.IsActive(fullscreenvideo)</start>
		<onstart condition="!Window.IsActive(videoosd) + !System.HasActiveModalDialog">ActivateWindow(VideoOSD)</onstart>
		<stop>!Player.Paused | !Player.HasVideo | !Window.IsActive(fullscreenvideo)</stop>
	</timer>
	<!-- folder previews: generated by tools/make_folder_previews.py -->
	<timer>
		<name>oak_preview_Home1</name>
		<start reset="true">!Container(8701).IsUpdating + !String.IsEqual(Container(8701).ListItemAbsolute(0).FileNameAndPath,Window(home).Property(oakdirHome1))</start>
		<onstart>SetProperty(oakdirHome1,$INFO[Container(8701).ListItemAbsolute(0).FileNameAndPath],home)</onstart>
		<onstart>SetProperty(oakprevHome1,$VAR[FolderFrameHome1],home)</onstart>
		<stop>![!Container(8701).IsUpdating + !String.IsEqual(Container(8701).ListItemAbsolute(0).FileNameAndPath,Window(home).Property(oakdirHome1))]</stop>
