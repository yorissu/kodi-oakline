<?xml version="1.0" encoding="UTF-8"?>
<!--
	Live TV programme / recording / timer info. Kodi enables only the
	buttons that apply: 5 switch to channel · 8 play recording · 6 record ·
	9 add timer · 11 reminder · 10 find similar · 4 close.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>
		<include>DialogScrim</include>
		<control type="group">
			<left>260</left>
			<top>170</top>
			<include>DialogEase</include>
			<include content="DialogPanel">
				<param name="width" value="1400" />
				<param name="height" value="740" />
				<param name="heading_id" value="9002" />
			</include>
			<control type="label">
				<left>40</left>
				<top>32</top>
				<width>1080</width>
				<height>44</height>
				<font>head</font>
				<textcolor>white</textcolor>
				<label>$INFO[ListItem.EpgEventTitle]$INFO[ListItem.EpisodeName,  ·  ]</label>
			</control>
			<control type="image">
				<left>1180</left>
				<top>30</top>
				<width>180</width>
				<height>100</height>
				<aspectratio aligny="top">keep</aspectratio>
				<texture background="true">$INFO[ListItem.Icon]</texture>
			</control>
			<control type="label">
				<left>40</left>
				<top>84</top>
				<width>1100</width>
				<height>30</height>
				<font>small</font>
				<textcolor>gray400</textcolor>
				<label>$INFO[ListItem.ChannelName]$INFO[ListItem.Date,  ·  ]$INFO[ListItem.Duration,  ·  ]$INFO[ListItem.Genre,  ·  ]$INFO[ListItem.Season,  ·  S]$INFO[ListItem.Episode, E]</label>
			</control>
			<control type="progress">
				<left>40</left>
				<top>128</top>
				<width>1320</width>
				<height>5</height>
				<texturebg colordiffuse="gray600">white.png</texturebg>
				<midtexture colordiffuse="wood">white.png</midtexture>
				<info>ListItem.Progress</info>
				<visible>Integer.IsGreater(ListItem.Progress,0)</visible>
			</control>
			<control type="textbox" id="400">
				<left>40</left>
				<top>160</top>
				<width>1320</width>
				<height>420</height>
				<font>body</font>
				<textcolor>gray200</textcolor>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll delay="8000" time="2500" repeat="8000">true</autoscroll>
			</control>
			<control type="grouplist" id="9000">
				<onleft>noop</onleft>
				<onright>noop</onright>
				<left>40</left>
				<top>640</top>
				<width>1320</width>
				<height>60</height>
				<orientation>horizontal</orientation>
				<itemgap>14</itemgap>
				<control type="button" id="5">
					<include>ButtonStyle</include>
					<label>Switch to channel</label>
					<visible>Control.IsEnabled(5)</visible>
				</control>
				<control type="button" id="8">
					<include>ButtonStyle</include>
					<label>Play recording</label>
					<visible>Control.IsEnabled(8)</visible>
				</control>
				<control type="button" id="6">
					<include>ButtonStyle</include>
					<label>$VAR[PVRRecordLabel]</label>
					<visible>Control.IsEnabled(6)</visible>
				</control>
				<control type="button" id="9">
					<include>ButtonStyle</include>
					<label>Add timer</label>
					<visible>Control.IsEnabled(9)</visible>
				</control>
				<control type="button" id="11">
					<include>ButtonStyle</include>
					<label>Reminder</label>
					<visible>Control.IsEnabled(11)</visible>
				</control>
				<control type="button" id="10">
					<include>ButtonStyle</include>
					<label>Find similar</label>
					<visible>Control.IsEnabled(10)</visible>
				</control>
				<control type="button" id="4">
					<include>ButtonStyle</include>
					<label>Close</label>
				</control>
			</control>
		</control>
	</controls>
</window>
