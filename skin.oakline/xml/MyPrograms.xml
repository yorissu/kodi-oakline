<?xml version="1.0" encoding="UTF-8"?>
<!-- Programs: program add-ons and launchers. -->
<window>
	<defaultcontrol always="true">500</defaultcontrol>
	<backgroundcolor>navy900</backgroundcolor>
	<views>500,50</views>
	<include>ScreenEase</include>
	<controls>
		<include content="PageHeader">
			<param name="title" value="Programs" />
			<param name="sub" value="$INFO[Container.NumItems,, items]" />
			<param name="right" value="$VAR[InfoTitle]" />
			<param name="right2" value="$INFO[ListItem.Label2]" />
		</include>
		<include content="BrowseGrid" />
		<include content="BrowseList" />
		<include content="EmptyNote">
			<param name="text" value="No program add-ons installed." />
			<param name="visible" value="Integer.IsEqual(Container.NumItems,0)" />
		</include>
		<include>NowPlayingMini</include>
		<include content="Rail">
			<param name="onright" value="SetFocus($VAR[BrowseView])" />
		</include>
		<include content="OptionsPanel">
			<param name="return" value="$VAR[BrowseView]" />
			<param name="extras" value="OptionsNone" />
		</include>
	</controls>
</window>
