<?xml version="1.0" encoding="UTF-8"?>
<!-- Slideshow: Kodi draws the pictures. The skin only adds a small card
     while paused (or with the Info key): name, position, date, camera. -->
<window>
	<controls>
		<control type="group">
			<left>96</left>
			<top>876</top>
			<visible>Slideshow.IsPaused | Slideshow.IsActive + Player.ShowInfo</visible>
			<animation effect="fade" start="0" end="100" time="200">Visible</animation>
			<animation effect="fade" start="100" end="0" time="160">Hidden</animation>
			<include content="Box">
				<param name="width" value="900" />
				<param name="height" value="108" />
				<param name="color" value="navy950" />
			</include>
			<include content="Box">
				<param name="width" value="4" />
				<param name="height" value="108" />
				<param name="color" value="wood" />
			</include>
			<control type="label">
				<left>32</left>
				<top>16</top>
				<width>840</width>
				<height>40</height>
				<font>head</font>
				<textcolor>white</textcolor>
				<label>$INFO[Slideshow.FileName]</label>
			</control>
			<control type="label">
				<left>32</left>
				<top>60</top>
				<width>840</width>
				<height>30</height>
				<font>small</font>
				<textcolor>gray400</textcolor>
				<label>$VAR[SlideState]$INFO[Slideshow.SlideIndex,  ·  ,]$INFO[Container.NumItems, of ,]$INFO[Slideshow.EXIFDate,  ·  ]$INFO[Slideshow.CameraModel,  ·  ]</label>
			</control>
		</control>
	</controls>
</window>
