<?xml version="1.0" encoding="UTF-8"?>
<!-- Now playing queue (video or music playlist). Kodi ids: 20 shuffle, 26 repeat, 21 save, 22 clear. -->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>navy900</backgroundcolor>
	<views>50</views>
	<include>ScreenEase</include>
	<controls>
		<include content="PageHeader">
			<param name="title" value="$VAR[PlaylistTitle]" />
			<param name="sub" value="$INFO[Container.NumItems,, items]$INFO[Playlist.Position,  ·  playing item ,]" />
			<param name="right" value="$INFO[ListItem.Label]" />
			<param name="right2" value="$INFO[ListItem.Duration]" />
		</include>
		<include content="BrowseList" />
		<include content="EmptyNote">
			<param name="text" value="The playlist is empty. Use Queue from an item's context menu to add to it." />
			<param name="visible" value="Integer.IsEqual(Container.NumItems,0)" />
		</include>
		<include>NowPlayingMini</include>
		<include content="Rail">
			<param name="onright" value="SetFocus(50)" />
		</include>
		<include content="OptionsPanel">
			<param name="return" value="50" />
			<param name="extras" value="OptionsPlaylist" />
		</include>
	</controls>
</window>
