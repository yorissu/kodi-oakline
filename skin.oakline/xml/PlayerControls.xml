<?xml version="1.0" encoding="UTF-8"?>
<!-- Small player controls dialog (ActivateWindow(PlayerControls), also used
     for remote players): previous, play/pause, stop, next, repeat, shuffle. -->
<window>
	<defaultcontrol always="true">602</defaultcontrol>
	<controls>
		<control type="group">
			<left>560</left>
			<top>840</top>
			<include>DialogEase</include>
			<include content="Box">
				<param name="width" value="800" />
				<param name="height" value="180" />
				<param name="color" value="navy950" />
			</include>
			<include content="Box">
				<param name="width" value="800" />
				<param name="height" value="4" />
				<param name="color" value="wood" />
			</include>
			<control type="label">
				<left>40</left>
				<top>20</top>
				<width>720</width>
				<height>40</height>
				<font>card</font>
				<textcolor>white</textcolor>
				<label>$INFO[Player.Title]</label>
			</control>
			<control type="group">
				<left>40</left>
				<top>86</top>
				<include content="IconButton"><param name="id" value="600" /><param name="left" value="0" /><param name="icon" value="icons/prev.png" /><param name="onclick" value="PlayerControl(Previous)" /><param name="onleft" value="607" /><param name="onright" value="602" /></include>
				<include content="IconButton"><param name="id" value="602" /><param name="left" value="80" /><param name="icon" value="$VAR[PlayPauseIcon]" /><param name="onclick" value="PlayerControl(Play)" /><param name="onleft" value="600" /><param name="onright" value="603" /></include>
				<include content="IconButton"><param name="id" value="603" /><param name="left" value="160" /><param name="icon" value="icons/stop.png" /><param name="onclick" value="PlayerControl(Stop)" /><param name="onleft" value="602" /><param name="onright" value="605" /></include>
				<include content="IconButton"><param name="id" value="605" /><param name="left" value="240" /><param name="icon" value="icons/next.png" /><param name="onclick" value="PlayerControl(Next)" /><param name="onleft" value="603" /><param name="onright" value="704" /></include>
				<include content="IconButton"><param name="id" value="704" /><param name="left" value="560" /><param name="icon" value="icons/repeat.png" /><param name="onclick" value="PlayerControl(Repeat)" /><param name="onleft" value="605" /><param name="onright" value="607" /></include>
				<include content="IconButton"><param name="id" value="607" /><param name="left" value="640" /><param name="icon" value="icons/shuffle.png" /><param name="onclick" value="PlayerControl(Random)" /><param name="onleft" value="704" /><param name="onright" value="600" /></include>
			</control>
		</control>
	</controls>
</window>
