<?xml version="1.0" encoding="UTF-8"?>
<!-- Context menu, also used for "Resume from ... / Play from beginning".
     Kodi fills grouplist 996 with copies of button 1000. -->
<window>
	<defaultcontrol>996</defaultcontrol>
	<animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="100">WindowClose</animation>
	<coordinates>
		<left>660</left>
		<top>340</top>
	</coordinates>
	<controls>
		<control type="image">
			<left>-660</left>
			<top>-340</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="scrim">white.png</texture>
		</control>
		<control type="image" id="999">
			<left>0</left>
			<top>0</top>
			<width>600</width>
			<height>400</height>
			<texture colordiffuse="navy950">white.png</texture>
		</control>
		<include content="Box">
			<param name="width" value="600" />
			<param name="height" value="4" />
			<param name="color" value="wood" />
		</include>
		<control type="grouplist" id="996">
			<onup>noop</onup>
			<ondown>noop</ondown>
			<left>24</left>
			<top>28</top>
			<width>552</width>
			<height max="680">auto</height>
			<itemgap>4</itemgap>
			<usecontrolcoords>true</usecontrolcoords>
		</control>
		<control type="button" id="1000">
			<width>552</width>
			<height>64</height>
			<font>rail</font>
			<textcolor>gray200</textcolor>
			<focusedcolor>onwood</focusedcolor>
			<textoffsetx>24</textoffsetx>
			<aligny>center</aligny>
			<texturefocus colordiffuse="wood">white.png</texturefocus>
			<texturenofocus />
		</control>
	</controls>
</window>
