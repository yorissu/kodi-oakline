<?xml version="1.0" encoding="UTF-8"?>
<!--
	Yes/no, OK, and progress messages. Kodi: 1 heading, 9 text,
	20 progress, buttons 10 / 11 / 12 (it labels and hides them).
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>
		<include>DialogScrim</include>
		<control type="group">
			<left>510</left>
			<top>330</top>
			<include>DialogEase</include>
			<include content="DialogPanel">
				<param name="width" value="900" />
				<param name="height" value="420" />
			</include>
			<control type="textbox" id="9">
				<left>40</left>
				<top>108</top>
				<width>820</width>
				<height>160</height>
				<font>body</font>
				<textcolor>gray200</textcolor>
				<autoscroll time="3000" delay="4000" repeat="5000">true</autoscroll>
			</control>
			<control type="progress" id="20">
				<left>40</left>
				<top>286</top>
				<width>820</width>
				<height>6</height>
				<texturebg colordiffuse="gray600">white.png</texturebg>
				<midtexture colordiffuse="wood">white.png</midtexture>
				<info>System.Progressbar</info>
			</control>
			<control type="grouplist" id="9000">
				<onleft>noop</onleft>
				<onright>noop</onright>
				<left>40</left>
				<top>326</top>
				<width>820</width>
				<height>60</height>
				<orientation>horizontal</orientation>
				<itemgap>16</itemgap>
				<include content="DialogButton"><param name="id" value="11" /></include>
				<include content="DialogButton"><param name="id" value="10" /></include>
				<include content="DialogButton"><param name="id" value="12" /></include>
			</control>
		</control>
	</controls>
</window>
