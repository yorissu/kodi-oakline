<?xml version="1.0" encoding="UTF-8"?>
<!-- Live TV timers and timer rules. -->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>navy900</backgroundcolor>
	<views>50</views>
	<include>ScreenEase</include>
	<controls>
		<include content="PVRHeader"><param name="section" value="$VAR[TimersSection]" /></include>
		<include content="PVRTabs"><param name="ondown" value="50" /></include>
		<include content="BrowseList"><param name="top" value="336" /><param name="height" value="744" /><param name="onup" value="9070" /></include>
		<include content="EmptyNote">
			<param name="text" value="No timers. Set one from the guide: select a programme, then Record." />
			<param name="visible" value="Integer.IsEqual(Container.NumItems,0)" />
		</include>
		<include>NowPlayingMini</include>
		<include content="Rail">
			<param name="onright" value="SetFocus(50)" />
		</include>
		<include content="OptionsPanel">
			<param name="return" value="50" />
			<param name="extras" value="OptionsPVRTimers" />
		</include>
	</controls>
</window>
